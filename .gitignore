*~

# OS
Thumbs.db

# Installed agent skills (local tooling, not project source)
.agents/
.claude/
skills-lock.json

# Scratch screenshots / test artifacts (root-level only)
/*.png
/*.jpg
/*.jpeg
/img-requests.txt
.playwright-mcp/

# Background-removal local cache
scripts/.bg-cache/

# Creativos de anuncios (IG/Meta): salida local, no forma parte del sitio
/ads/

# Source supplier catalogs / price lists (local reference only, not for the repo)
/catalogos-originales/

# Generated catalog exports (output of scripts/generate-catalog-excel.py)
/catalogo_productos.xlsx
/catalogo_productos.b64

# Single package manager: pnpm (pnpm-lock.yaml is the source of truth).
# Keep npm's lockfile out so it can't drift from pnpm-lock and break CI/Vercel.
package-lock.json

# Scratch dir for favicon generation (holds the temp logo + any local API key).
_favicon_work/

# Fotos originales de producto: quedan solo en local, no en el repo.
# Pesan ~1 GB contra 27 MB de las variantes generadas, y el sitio no las
# necesita: las tarjetas usan .thumbs/*.webp, y el modal de pantalla completa
# usa .thumbs/*.med.webp (~1200px) como fuente principal, cayendo al original
# solo si esa falla. Se ignoran las imagenes que estan sueltas en la carpeta de
# cada producto; las de .thumbs/ (un nivel mas abajo) si se versionan.
# Las de los productos ya versionados antes de esta regla siguen trackeadas.
public/images/Categorias/*/*/*.jpg
public/images/Categorias/*/*/*.jpeg
public/images/Categorias/*/*/*.png
public/images/Categorias/*/*/*.webp
